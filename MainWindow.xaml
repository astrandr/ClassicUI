<Window x:Class="ClassicUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassicUI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Shape Painter" Height="450" Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="ControlBackground" Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ToolBar Grid.Column="0" Grid.Row="0" VerticalAlignment="Top" Background="{StaticResource ControlBackground}" Height="42.7">
            <StackPanel Orientation="Horizontal">
                <Button Content="Rectangle" Style="{StaticResource RaisedButtonStyle}"/>
                <Button Content="Ellipse" Style="{StaticResource RaisedButtonStyle}"/>
                <Button Content="Triangle" Style="{StaticResource RaisedButtonStyle}"/>
            </StackPanel>

            <Separator/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Select" Style="{StaticResource RaisedButtonStyle}"/>
                <Button Content="Delete" Style="{StaticResource RaisedButtonStyle}"/>
            </StackPanel>
        </ToolBar>
        <Grid Grid.Column="0" Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120pt"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="Green" BorderBrush="Red"/>
            <Grid Grid.Column="1">
                <StackPanel Orientation="Vertical" Background="{StaticResource ControlBackground}">
                    <TextBlock Text="Shape properties" HorizontalAlignment="Center" Margin="0,4,0,4" Height="Auto"/>
                    <local:ShapePropertiesGrid x:Name="PropertiesGrid" ColumnHeader="{Binding GridColumnHeader}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <StatusBar Grid.Column="0" Grid.Row="2" Background="{StaticResource ControlBackground}">
            <StatusBarItem Content="Something 1" FontSize="12pt" Margin ="4, 0, 4, 0"/>
            <Separator/>
            <StatusBarItem Content="Something 2" FontSize="12pt" Margin ="4, 0, 4, 0"/>
        </StatusBar>
    </Grid>
</Window>
